load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary", "cc_test")

cc_library(
    name = "fschema",
    srcs = glob([
        "fschema/**/*.cc",
        "fschema/**/*.inc",
        "fschema/**/internal/*.h",
        "fschema/third_party/**/*.h",
    ]),
    hdrs = glob(
        include = ["fschema/**/*.h"],
        exclude = [
            "fschema/**/internal/*.h",
            "fschema/third_party/**/*.h",
        ],
    ),
    includes = ["."],
    copts = select({
        "@platforms//os:windows": [
            "/std:c++latest",
            "/W4",
            "/WX-",
            "/utf-8",
            "/Zc:__cplusplus",
            "/permissive-",
        ],
        "//conditions:default": [
            "-std=c++23",
            "-Wall",
            "-Wextra",
            "-Wpedantic",
            "-Wconversion",
            "-Wshadow",
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "@abseil//absl/base",
        "@abseil//absl/container:flat_hash_map",
        "@abseil//absl/container:flat_hash_set",
        "@abseil//absl/synchronization",
        "@abseil//absl/time",
        "@highway//:hwy",
        "@libdeflate//:libdeflate",
        "@onetbb//:tbb",
    ],
)

# Tests

cc_test(
    name = "fschema_litematica_parse_test",
    srcs = [
        "fschema/tests/litematica_parse_test.cc",
        "fschema/tests/testdata_util.h",
    ],
    copts = select({
        "@platforms//os:windows": ["/std:c++latest"],
        "//conditions:default": ["-std=c++23"],
    }),
    defines = ["FASTSCHEMA_TESTDATA_DIR=\"fschema/testdata\""],
    data = glob(["fschema/testdata/**"]),
    deps = [
        ":fschema",
        "@highway//:hwy",
        "@googletest//:gtest_main",
        "@onetbb//:tbb",
    ],
)

