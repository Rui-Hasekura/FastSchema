load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary", "cc_test")

cc_library(
    name = "fschema",
    srcs = glob(["fschema/**/*.cc"]) + glob([
        "fschema/**/internal/*.h",
        "fschema/memory/*.h",
    ]),
    hdrs = glob([
        "fschema/base/*.h",
        "fschema/litematic/*.h",
        "fschema/schem/*.h",
    ]),
    includes = ["."],
    copts = select({
        "@platforms//os:windows": [
            "/std:c++latest",
            "/W4",
            "/WX-",
            "/utf-8",
            "/Zc:__cplusplus",
            "/permissive-",
        ],
        "//conditions:default": [
            "-std=c++23",
            "-Wall",
            "-Wextra",
            "-Wpedantic",
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "@highway//:hwy",
        "//third_party:libdeflate",
        "//third_party:tbb",
    ],
)

#  Tests

cc_test(
    name = "fschema_litematic_parse_test",
    srcs = [
        "fschema/tests/litematic_parse_test.cc",
        "fschema/tests/testdata_util.h",
    ],
    copts = select({
        "@platforms//os:windows": ["/std:c++latest"],
        "//conditions:default": ["-std=c++23"],
    }),
    defines = ["FASTSCHEMA_TESTDATA_DIR=\"fschema/testdata\""],
    data = glob(["fschema/testdata/**"]),
    deps = [":fschema", "@googletest//:gtest_main"],
)

