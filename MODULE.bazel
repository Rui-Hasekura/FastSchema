module(
    name = "FastSchema",
    version = "1.0.0",
)

bazel_dep(name = "rules_cc", version = "0.0.9")
bazel_dep(name = "platforms", version = "0.0.8")
bazel_dep(name = "rules_foreign_cc", version = "0.10.1")

bazel_dep(name = "highway", version = "1.4.0")
bazel_dep(name = "google_benchmark", version = "1.9.5")
bazel_dep(name = "googletest", version = "1.18.0")

# libdeflate — not on BCR, build from source via cmake_external
new_git_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:git.bzl", "new_git_repository")

new_git_repository(
    name = "libdeflate_src",
    remote = "https://github.com/ebiggers/libdeflate.git",
    tag = "v1.22",
    build_file_content = """
filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
)

# oneTBB — not on BCR, build from source via cmake_external
new_git_repository(
    name = "onetbb_src",
    remote = "https://github.com/oneapi-src/oneTBB.git",
    tag = "v2021.13.0",
    build_file_content = """
filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
)