module(
    name = "FastSchema",
    version = "1.0.0",
)

bazel_dep(name = "rules_cc", version = "0.0.9")
bazel_dep(name = "platforms", version = "0.0.8")
bazel_dep(name = "rules_foreign_cc", version = "0.10.1")

bazel_dep(
    name = "abseil-cpp",
    version = "20260817.0",
    repo_name = "abseil",
)

bazel_dep(name = "highway", version = "1.4.0")
bazel_dep(name = "google_benchmark", version = "1.9.5")
bazel_dep(name = "googletest", version = "1.18.0")

# libdeflate — not on BCR
http_archive(
    name = "libdeflate_src",
    url = "https://github.com/ebiggers/libdeflate/archive/refs/tags/v1.26.tar.gz",
    strip_prefix = "libdeflate-1.26",
    build_file_content = """
filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
)

# oneTBB — static and not on BCR
http_archive(
    name = "onetbb_src",
    url = "https://github.com/oneapi-src/oneTBB/archive/refs/tags/v2023.1.0.tar.gz",
    strip_prefix = "oneTBB-2023.1.0",
    build_file_content = """
filegroup(
    name = "all_srcs",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)
""",
)