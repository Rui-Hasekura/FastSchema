load("@rules_foreign_cc//foreign_cc:defs.bzl", "cmake_external")

cmake_external(
    name = "libdeflate",
    lib_source = "@libdeflate_src//:all_srcs",
    cache_entries = {
        "LIBDEFLATE_BUILD_TESTS": "OFF",
        "LIBDEFLATE_BUILD_GZIP": "OFF",
        "BUILD_SHARED_LIBS": "OFF",
    },
    out_static_libs = ["libdeflate.a"],
)

cmake_external(
    name = "tbb",
    lib_source = "@onetbb_src//:all_srcs",
    cache_entries = {
        "TBB_TEST": "OFF",
        "TBB_EXAMPLES": "OFF",
        "BUILD_SHARED_LIBS": "OFF",
    },
    out_static_libs = ["libtbb.a", "libtbbmalloc.a"],
)